rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        request.auth.token.email.matches('.*@novogenics[.]internal$')
      );
    }

    function isOwner(clientId) {
      return isAuthenticated() && request.auth.uid == clientId;
    }

    function isValidImage() {
      return request.resource.size < 10 * 1024 * 1024 // 10MB
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    // Gallery imagery (Post-registration)
    match /gallery/{clientId}/{fileName} {
      allow read: if isAdmin() || isOwner(clientId);
      allow write: if isAdmin() || (isOwner(clientId) && isValidImage());
    }
    
    // Assessment imagery (During intake)
    match /assessments/{clientId}/{fileName} {
      // Admins can read everything. Clients can only read their own (if they have an ID)
      allow read: if isAdmin() || isOwner(clientId);
      
      // Allow write only if:
      // 1. Admin
      // 2. Logged-in client writing to their own folder (UID-keyed)
      // 3. Authenticated (incl. anonymous Firebase Auth) intake to a C-* temp folder
      // Unauthenticated writes are no longer permitted. Public assessment flows must
      // sign the user in via Firebase Anonymous Auth (and App Check) before upload.
      allow write: if isAdmin() ||
                    (isOwner(clientId) && isValidImage()) ||
                    (isAuthenticated() && clientId.matches('^C-[A-Z0-9]+$') && isValidImage());
    }
    
    // Explicit deny for everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
