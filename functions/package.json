{
  "name": "novogencis-functions",
  "description": "Cloud Functions for Novogencis clinical platform — AI triage, automation",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "22"
  },
  "type": "module",
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.40.1",
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^6.1.0",
    "stripe": "^17.7.0"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  }
}
