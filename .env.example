# ─────────────────────────────────────────────────────────────
# Novogenics Clinical Platform — Environment Variables
# Copy this file to .env.local (never commit .env.local)
# All variables must be prefixed VITE_ to be exposed to the
# browser bundle at build time.
# ─────────────────────────────────────────────────────────────

# ── EmailJS (client-side email notifications) ───────────────
# Obtain from https://dashboard.emailjs.com → Account → API Keys
# NOTE: These are embedded in the JS bundle. EmailJS is intended
# for server-free use but replace with a Cloud Function + a
# transactional provider (Resend / Postmark) for higher volume.
VITE_EMAILJS_SERVICE_ID=service_xxxxxxx
VITE_EMAILJS_PUBLIC_KEY=xxxxxxxxxxxxxxxx

# Email address that receives admin-bound notifications
VITE_ADMIN_NOTIFICATION_EMAIL=admin@novogenics.co.uk

# ── EmailJS Template IDs ─────────────────────────────────────
# Create each template at https://dashboard.emailjs.com → Email Templates
VITE_EMAILJS_TEMPLATE_NEW_ASSESSMENT=template_xxxxxxx
VITE_EMAILJS_TEMPLATE_NEW_MESSAGE_ADMIN=template_xxxxxxx
VITE_EMAILJS_TEMPLATE_NEW_MESSAGE_CLIENT=template_xxxxxxx
VITE_EMAILJS_TEMPLATE_FORM_SIGNED=template_xxxxxxx
VITE_EMAILJS_TEMPLATE_FEEDBACK_RECEIVED=template_xxxxxxx
VITE_EMAILJS_TEMPLATE_APPOINTMENT_CONFIRMED=template_xxxxxxx
VITE_EMAILJS_TEMPLATE_PAYMENT_RECEIVED=template_xxxxxxx
VITE_EMAILJS_TEMPLATE_WELCOME=template_xxxxxxx
VITE_EMAILJS_TEMPLATE_DAILY_BRIEFING=template_xxxxxxx

# ── Stripe payment link ──────────────────────────────────────
# Production Payment Link URL from https://dashboard.stripe.com/payment-links
# (Do NOT use a test_* link in production — patients will be sent to a sandbox.)
# A future iteration should replace this with a server-created Checkout
# Session so the amount is signed server-side rather than baked into a link.
VITE_STRIPE_PAYMENT_LINK=https://buy.stripe.com/your_live_link_here
